@page
@model IndexModel
@{
    ViewData["Title"] = "Expense Management System";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Expense Management System</h1>
    <p class="lead">Manage your business expenses efficiently</p>
    <div class="mt-4">
        <a class="btn btn-primary btn-lg me-2" asp-page="/AddExpense">Add Expense</a>
        <a class="btn btn-secondary btn-lg me-2" asp-page="/Expenses">View Expenses</a>
        <a class="btn btn-info btn-lg" asp-page="/ApproveExpenses">Approve Expenses</a>
    </div>
</div>

